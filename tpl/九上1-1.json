 "tpls": [
  {
   "tpl": "CR-frac",
   "title": "分數連比化成最簡整數比",
   "kind": "crFrac",
   "bloom": "應用",
   "lc": "A-9-1",
   "seg": "九上1-1-S1",
   "params": {
    "a": [
     2,
     3,
     4,
     5,
     6,
     7,
     8,
     9
    ],
    "b": [
     2,
     3,
     4,
     5,
     6,
     7,
     8,
     9
    ],
    "c": [
     2,
     3,
     4,
     5,
     6,
     7,
     8,
     9
    ],
    "i": [
     1,
     2,
     3
    ]
   },
   "let": {
    "L": "lcm(a, b, c)",
    "ai": "i == 1 ? a : i == 2 ? b : c",
    "NT": "i == 1 ? '一' : i == 2 ? '二' : '三'"
   },
   "when": "a < b && b < c && b * b != a * c",
   "distinctAB": [
    "c"
   ],
   "stem": "把 1/{a}：1/{b}：1/{c} 化成最簡整數比，第{NT}項是多少？",
   "answer": "L / ai",
   "check": {
    "type": "value",
    "expr": "1/{ai}*{L}"
   },
   "okfb": "正確！各項同乘分母的最小公倍數 {L}，得 {L / a}：{L / b}：{L / c}，三數沒有公因數，第{NT}項是 {L / ai}。",
   "hint": "各項要乘「同一個」數；乘分母的最小公倍數最快。",
   "distractors": [
    "CR08",
    "CR10",
    "CR09",
    "CR11"
   ],
   "pick": 3
  },
