  },
  {
   "tpl": "WP-speed",
   "title": "速率問題列式",
   "kind": "wpSpeed",
   "bloom": "分析",
   "lc": "A-7-3",
   "seg": "七上3-3-S3",
   "params": {
    "v1": [
     10,
     12,
     15,
     18,
     20
    ],
    "v2": [
     3,
     4,
     5,
     6
    ],
    "x0": [
     2,
     3,
     4,
     5,
     6,
     8,
     9
