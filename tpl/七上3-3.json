     1,
     2
    ]
   },
   "let": {
    "k": "x0 * (2 * d - 10) / 10",
    "DN": "d == 6 ? '六' : d == 7 ? '七' : d == 8 ? '八' : '九'",
    "IT": "w == 0 ? '汽水' : w == 1 ? '果汁' : '牛奶'",
    "U": "w == 0 ? '瓶' : w == 1 ? '罐' : '盒'"
   },
   "stem": "某{IT}促銷：買 2 {U}打{DN}折，只比買 1 {U}原價多 {k} 元。設一{U}原價 x 元，下列哪一個方程式正確？",
   "answer": "'2x×0.' + d + '＝x＋' + k",
   "check": {
    "type": "sameSol",
    "sol": {
     "x": "{x0}"
    }
   },
   "okfb": "正確！2 {U}打折前是 2x 元，打{DN}折是 2x×0.{d}，比 1 {U}原價 x 多 {k} 元。",
   "hint": "先寫出 2 {U}打折前的總價，再整個乘折數。",
   "distractors": [
    "WP07",
    "WP08",
    "WP09"
