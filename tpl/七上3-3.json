   "when": "(60 * x0 * (v1 - v2)) % (v1 * v2) == 0 && t <= 150",
   "stem": "從家到圖書館共 x 公里。騎腳踏車每小時 {v1} 公里，走路每小時 {v2} 公里，騎車比走路少花 {t} 分鐘。下列哪一個方程式正確？",
   "answer": "'x/' + v2 + '−x/' + v1 + '＝' + t + '/60'",
   "check": {
    "type": "sameSol",
    "sol": {
     "x": "{x0}"
    }
   },
   "okfb": "正確！時間＝距離÷速率：走路 x/{v2} 小時、騎車 x/{v1} 小時，相差 {t} 分鐘＝{t}/60 小時。",
   "hint": "先把距離、速率、時間分三欄；單位要一致。",
   "distractors": [
    "WP10",
    "WP11",
    "WP04"
   ],
   "pick": 3,
   "distinctAB": [
    "x0"
   ]
  }
 ]
