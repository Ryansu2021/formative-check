   "kind": "wpChick",
   "bloom": "理解",
   "lc": "A-7-3",
   "seg": "七上3-3-S1",
   "params": {
    "c": [
     0,
     1
    ],
    "N": [
     10,
     12,
     15,
     16,
     18,
     20,
