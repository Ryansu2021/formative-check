  "code": "3-3",
  "name": "一元一次方程式的應用",
  "curriculum": [
   "A-7-3 一元一次方程式的解法與應用"
  ]
 },
 "note": "每個模板產一組平行題（A、B 卷同一組規則、不同數字）；distractors 是 src/units/七上3-3.js 的規則 id（迷思代碼沿用 題庫_七上3-3_一元一次方程式的應用_路線A.json 的 WP01～WP14）。v3.11（2026-11-10）新增",
 "coverage": {
  "min": 10,
  "note": "每個迷思至少能產生 10 種不同題目（2026-11-10 老師裁定：比照七上 2-2）",
  "exclude": {
   "WP12": "「解出後不檢驗合理性」的正解是「這樣的買法不存在」，要人工判讀（現成題庫 P07 是 manual 題），驗算器沒辦法自動驗算"
  }
 },
 "tpls": [
  {
   "tpl": "WP-age",
   "title": "年齡問題（x 年後）",
   "kind": "wpAge",
   "bloom": "應用",
   "lc": "A-7-3",
   "seg": "七上3-3-S2",
   "params": {
    "S": [
     6,
     7,
     8,
     9,
     10,
     11,
     12,
     13,
     14
    ],
    "x0": [
     2,
     3,
     4,
     5,
     6,
     8,
     10
    ],
    "m": [
     2,
     3
    ]
   },
   "let": {
    "F": "m * (S + x0) - x0",
    "D": "m * (S + x0) - x0 - S"
   },
   "when": "D >= 20 && F <= 60",
   "stem": "爸爸今年 {F} 歲，比兒子大 {D} 歲。設 x 年後，爸爸的年齡是兒子的 {m} 倍，下列哪一個方程式正確？",
   "answer": "F + '＋x＝' + m + '(' + F + '−' + D + '＋x)'",
   "check": {
    "type": "sameSol",
    "sol": {
     "x": "{x0}"
    }
   },
   "okfb": "正確！兒子今年 {F}−{D}＝{S} 歲；x 年後爸爸 {F}＋x 歲、兒子 {S}＋x 歲，爸爸是兒子的 {m} 倍。",
   "hint": "先畫表格：現在、x 年後，兩個人各幾歲？",
   "distractors": [
    "WP04",
    "WP01",
    "WP05"
   ],
   "pick": 3,
   "distinctAB": [
    "S"
   ]
  },
  {
   "tpl": "WP-ago",
   "title": "年齡問題（幾年前）",
   "kind": "wpAgo",
   "bloom": "應用",
   "lc": "A-7-3",
   "seg": "七上3-3-S2",
   "params": {
    "k": [
     1,
     2,
     3,
     4,
     5,
     6,
     7,
     8
    ],
    "B0": [
     3,
     4,
     5,
     6,
     7,
     8,
     9
    ],
    "m": [
     2,
     3
    ]
   },
   "let": {
    "A": "m * B0 + k",
    "B": "B0 + k"
   },
   "stem": "哥哥今年 {A} 歲，弟弟今年 {B} 歲。幾年前，哥哥的年齡是弟弟的 {m} 倍？",
   "answer": "k + ' 年前'",
   "check": {
    "type": "solve",
    "eq": "{A}−x＝{m}({B}−x)"
   },
   "okfb": "正確！設 x 年前：{A}−x＝{m}({B}−x)，x＝{k}。那時哥哥 {A - k} 歲、弟弟 {B0} 歲。",
   "hint": "畫表格：現在、x 年前，兩個人各幾歲？",
   "distractors": [
    "WP13a",
    "WP13b",
    "WP05",
    "WP01"
   ],
   "pick": 3
  },
  {
   "tpl": "WP-chick",
