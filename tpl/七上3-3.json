    "f": "c == 0 ? '腳' : '輪子'"
   },
   "when": "x0 < N - 2",
   "stem": "{c == 0 ? '雞兔同籠，共 ' + N + ' 隻，腳共 ' + L + ' 隻。設兔有 x 隻' : '停車場的三輪車和腳踏車共 ' + N + ' 輛，輪子共 ' + L + ' 個。設三輪車有 x 輛'}，下列哪一個方程式正確？",
   "answer": "P + 'x＋2(' + N + '−x)＝' + L",
   "check": {
    "type": "sameSol",
    "sol": {
     "x": "{x0}"
    }
   },
   "okfb": "正確！另一種有 {N}−x {u}；{f}數：{P}x＋2({N}−x)＝{L}。",
   "hint": "x 之外的另一種有幾{u}？等號兩邊要都是「{f}數」。",
   "distractors": [
    "WP02",
    "WP03",
    "WP14"
   ],
   "pick": 3,
   "distinctAB": [
    "N"
   ]
  },
  {
   "tpl": "WP-share",
   "title": "盈不足問題",
   "kind": "wpShare",
   "bloom": "理解",
   "lc": "A-7-3",
   "seg": "七上3-3-S2",
   "params": {
    "w": [
     0,
     1,
     2
    ],
    "a": [
     3,
     4,
     5,
     6
    ],
    "g": [
     1,
     2
    ],
    "x0": [
     6,
     7,
     8,
     9,
     10,
     12,
     15
    ],
    "p": [
     2,
     3,
     4,
     5,
     6,
     7,
     8,
     9
    ]
   },
   "let": {
    "b": "a + g",
    "q": "g * x0 - p",
    "T": "w == 0 ? '糖果' : w == 1 ? '鉛筆' : '貼紙'",
    "U": "w == 0 ? '顆' : w == 1 ? '枝' : '張'"
   },
   "when": "q > 0 && p != q",
   "stem": "老師分{T}給學生，每人 {a} {U}會多 {p} {U}，每人 {b} {U}會少 {q} {U}。設有 x 人，下列哪一個方程式正確？",
   "answer": "a + 'x＋' + p + '＝' + b + 'x−' + q",
   "check": {
    "type": "sameSol",
    "sol": {
     "x": "{x0}"
    }
   },
   "okfb": "正確！{T}總數不變：每人 {a} {U}再加多出的 {p} {U}，等於每人 {b} {U}再減不足的 {q} {U}。",
   "hint": "畫圖標出多出和不足：哪兩個式子都表示{T}的總數？",
   "distractors": [
    "WP06a",
    "WP06b",
    "WP14"
   ],
   "pick": 3
  },
  {
   "tpl": "WP-disc",
   "title": "打折求原價",
   "kind": "wpDisc",
   "bloom": "理解",
   "lc": "A-7-3",
   "seg": "七上3-3-S2",
   "params": {
    "d": [
     6,
     7,
     8,
     9
    ],
    "X": [
     500,
     600,
     800,
     900,
     1000,
     1200,
     1500,
     1600,
     1800,
     2000,
     2400,
     3000
    ],
    "w": [
     0,
     1,
     2
    ]
   },
   "let": {
    "P": "X * d / 10",
    "DN": "d == 6 ? '六' : d == 7 ? '七' : d == 8 ? '八' : '九'",
    "IT": "w == 0 ? '一件外套' : w == 1 ? '一雙球鞋' : '一個書包'"
   },
   "stem": "{IT}打{DN}折後賣 {P} 元。原價是多少元？",
   "answer": "X + ' 元'",
   "check": {
    "type": "solve",
    "eq": "0.{d}x＝{P}"
   },
   "okfb": "正確！打{DN}折是賣原價的 0.{d} 倍：0.{d}x＝{P}，x＝{X}。",
   "hint": "打折後賣的是原價的幾成？誰乘以折數會等於售價？",
   "distractors": [
    "WP07",
    "WP07b",
    "WP13"
   ],
   "pick": 3,
   "distinctAB": [
    "X"
   ]
  },
  {
   "tpl": "WP-disc2",
   "title": "促銷打折列式",
   "kind": "wpDisc2",
   "bloom": "應用",
   "lc": "A-7-3",
   "seg": "七上3-3-S2",
   "params": {
    "d": [
     6,
     7,
     8,
     9
    ],
    "x0": [
     10,
     20,
     30,
     40,
     50,
     60,
     80
    ],
    "w": [
