{
  "schema": "fa-tpl/1",
  "unit": {
    "grade": "七上",
    "code": "2-4",
    "name": "指數律（同底數乘除、次方的次方、積的次方、分數與 0 次方）",
    "curriculum": [
      "N-7-7 指數律",
      "N-7-6 指數的意義（a⁰＝1、同底數比大小）"
    ]
  },
  "note": "每個模板產一組平行題（A、B 卷同一組規則、不同數字）；distractors 是 rules.js 的規則 id，pick 是每題用幾條",
  "tpls": [
    {
      "tpl": "EL-mul",
      "title": "同底數相乘",
      "kind": "elMul",
      "bloom": "理解",
      "lc": "N-7-7",
      "seg": "七上2-4-S2",
      "params": {
        "b": [
          2,
          3,
          5,
          7,
          -2,
          -3
        ],
        "m": [
          2,
          3,
          4
        ],
        "n": [
          3,
          4,
          5,
          6
        ]
      },
      "when": "m < n && m * n != m + n",
      "stem": "{pb(b,m)}×{pb(b,n)} 寫成指數形式是哪一個？",
      "answer": "pb(b, m + n)",
      "check": {
        "type": "powForm",
        "expr": "{pb(b,m)}×{pb(b,n)}",
        "base": "{b}"
      },
      "okfb": "正確！同底數相乘，指數相加：{m}＋{n}＝{m+n}，得 {pb(b,m+n)}。",
      "hint": "同底數相乘：底數不變，指數相加。",
      "distractors": [
        "EL01",
        "EL04",
        "EL10",
        "EL07"
      ],
      "pick": 3
    },
    {
      "tpl": "EL-div",
      "title": "同底數相除",
      "kind": "elDiv",
      "bloom": "理解",
      "lc": "N-7-7",
      "seg": "七上2-4-S2",
      "params": {
        "b": [
          2,
          3,
          5,
          6,
          7
        ],
        "m": [
          6,
          8,
          9,
          10,
          12
        ],
        "n": [
          2,
          3
        ]
      },
      "when": "m % n == 0 && m / n != m - n",
      "stem": "{pb(b,m)}÷{pb(b,n)} 寫成指數形式是哪一個？",
      "answer": "pb(b, m - n)",
      "check": {
        "type": "powForm",
        "expr": "{pb(b,m)}÷{pb(b,n)}",
        "base": "{b}"
      },
      "okfb": "正確！同底數相除，指數相減：{m}−{n}＝{m-n}，得 {pb(b,m-n)}。",
      "hint": "同底數相除：底數不變，指數相減。",
      "distractors": [
        "EL02",
        "EL10",
        "EL02b"
      ],
      "pick": 3
    },
    {
      "tpl": "EL-powpow",
      "title": "次方的次方",
      "kind": "elPowPow",
      "bloom": "理解",
      "lc": "N-7-7",
      "seg": "七上2-4-S3",
      "params": {
        "b": [
          -2,
          -3,
          -5
        ],
        "m": [
          2,
          3,
          5
        ],
        "n": [
          2,
          4
        ]
      },
      "when": "m * n != m + n",
      "stem": "({pb(b,m)})^{n} 寫成指數形式是哪一個？",
      "answer": "pb(b, m * n)",
      "check": {
        "type": "powForm",
        "expr": "({pb(b,m)})^{n}",
        "base": "{b}"
      },
      "okfb": "正確！次方的次方，指數相乘：{m}×{n}＝{m*n}，得 {pb(b,m*n)}。",
      "hint": "次方的次方：指數相乘；注意底數有負號要留在括號裡。",
      "distractors": [
        "EL03",
        "EL07",
        "EL11"
      ],
      "pick": 3
    },
    {
      "tpl": "EL-prod",
      "title": "積的次方",
      "kind": "elProd",
      "bloom": "理解",
      "lc": "N-7-7",
      "seg": "七上2-4-S3",
      "params": {
        "a": [
          2,
          3
        ],
        "c": [
          3,
          5,
          7
        ],
        "n": [
          3,
          4,
          5,
          6
        ]
      },
      "when": "a < c",
      "stem": "{a}^{n}×{c}^{n} 寫成一個次方是哪一個？",
      "answer": "pb(a * c, n)",
      "check": {
        "type": "powForm",
        "expr": "{a}^{n}×{c}^{n}",
        "base": "{a*c}"
      },
      "okfb": "正確！指數相同，底數相乘：({a}×{c})^{n}＝{a*c}^{n}。",
      "hint": "aⁿ×bⁿ＝(a×b)ⁿ：底數相乘，指數不變。",
      "distractors": [
        "EL04a",
        "EL04b",
        "EL01"
      ],
      "pick": 3
    },
    {
      "tpl": "EL-frac",
      "title": "分數的次方",
      "kind": "elFrac",
      "bloom": "理解",
      "lc": "N-7-7",
      "seg": "七上2-4-S1",
      "params": {
        "p": [
          2,
          3,
          4
        ],
        "q": [
          3,
          5,
          7
        ],
        "n": [
          2,
          3,
          4
        ]
      },
      "when": "p < q && gcd(p, q) == 1 && pow(q, n) <= 2500",
      "stem": "({p}/{q})^{n}＝？",
      "answer": "pow(p,n) + '/' + pow(q,n)",
      "check": {
        "type": "fraction",
        "expr": "({p}/{q})^{n}"
      },
      "okfb": "正確！分子分母都 {n} 次方：{p}^{n}/{q}^{n}＝{pow(p,n)}/{pow(q,n)}。",
      "hint": "分數的次方：分子、分母都要乘方。",
      "distractors": [
        "EL06a",
        "EL06b",
        "EL11"
      ],
      "pick": 3
    },
    {
      "tpl": "EL-zero",
      "title": "0 次方",
      "kind": "elZero",
      "bloom": "理解",
      "lc": "N-7-6",
      "seg": "七上2-4-S2",
      "params": {
        "c": [
          2,
          3,
          4,
          5
        ],
        "a": [
          2,
          3,
          4,
          5,
          6,
          7
        ]
      },
      "when": "c != a",
      "stem": "{c}×(−{a})^0＝？",
      "answer": "c",
      "check": {
        "type": "value",
        "expr": "{c}×(−{a})^0"
      },
      "okfb": "正確！(−{a})⁰＝1，{c}×1＝{c}。",
      "hint": "不是 0 的數，0 次方都是 1。",
      "distractors": [
        "EL08a",
        "EL08b",
        "EL07"
      ],
      "pick": 3
    }
  ]
}
