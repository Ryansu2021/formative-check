   "let": {
    "x": "st7RepCx(hi, c)",
    "lo": "st7RepLo(x)",
    "up": "st7RepHi(x)",
    "e": "st7RepElo(x) + e0 % (st7RepEhi(x) - st7RepElo(x) + 1)",
    "g": "up - lo + 1",
    "d1": "p == 1 ? e : lo + a1 % g",
    "d2": "p == 2 ? e : lo + a2 % g",
    "d3": "p == 3 ? e : lo + a3 % g",
    "d4": "p == 4 ? e : lo + a4 % g",
    "d5": "p == 5 ? e : lo + a5 % g",
    "d6": "p == 6 ? e : lo + a6 % g",
    "d7": "p == 7 ? e : lo + a7 % g",
    "d8": "p == 8 ? e : lo + a8 % g",
    "S": "d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8",
    "MN": "S / 8",
    "M": "st7Med(d1, d2, d3, d4, d5, d6, d7, d8)",
    "u": "st7RepU(x)"
   },
   "when": "S % 4 == 0 && st7RepSide(hi, p, MN, d1, d2, d3, d4, d5, d6, d7, d8) && MN != M && st7Mid2(d1, d2, d3, d4, d5, d6, d7, d8) && !st7RepUD(d1, d2, d3, d4, d5, d6, d7, d8)",
