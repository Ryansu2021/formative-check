    {
      "tpl": "PF-notFactor",
      "title": "用標準分解式判不是因數",
      "kind": "pf21NotF",
      "bloom": "分析",
      "lc": "N-7-2",
      "seg": "七上2-1-S2",
      "params": {
        "p": [
          2,
