      "when": "p < q && (r == 1 || q < r) && a + b >= 3 && n >= 60 && n <= 2000",
      "stem": "{n} 有幾個相異的質因數？",
      "answer": "distinctPrimes(n)",
      "check": {
        "type": "value",
        "fn": "distinctPrimes",
        "n": "{n}"
