{
  "schema": "fa-tpl/1",
  "unit": {
    "grade": "七上",
    "code": "2-1",
    "name": "質因數分解、標準分解式",
    "curriculum": [
      "N-7-1 質數與合數",
      "N-7-2 質因數分解的標準分解式"
    ]
  },
  "note": "每個模板產一組平行題（A、B 卷同一組規則、不同數字）；distractors 是 rules.js 的規則 id，pick 是每題用幾條",
  "tpls": [
    {
      "tpl": "PF-factorize",
      "title": "標準分解式辨認",
      "kind": "factorize",
      "bloom": "理解",
      "lc": "N-7-2",
      "seg": "七上2-1-S2",
      "params": {
        "p": [
          2,
          3
        ],
        "a": [
          1,
          2,
          3,
          4
        ],
        "q": [
          3,
          5,
          7
        ],
        "b": [
          1,
          2,
          3
        ],
        "r": [
          1,
          7,
          11,
          13
        ]
      },
      "let": {
        "n": "pow(p,a)*pow(q,b)*r"
      },
      "when": "p < q && (r == 1 || q < r) && a + b >= 3 && n >= 40 && n <= 800",
      "stem": "{n} 的標準分解式是哪一個？",
      "answer": "fac(n)",
      "check": {
        "type": "factorize",
        "n": "{n}"
      },
      "okfb": "正確！{n}＝{fac(n)}。",
      "hint": "分解完要檢查：都是質數嗎？相同的有合併嗎？乘回去是 {n} 嗎？",
      "distractors": [
        "PF07",
        "PF04",
        "PF03",
        "PF05",
        "PF01"
      ],
      "pick": 3
    },
    {
      "tpl": "PF-value",
      "title": "標準分解式求值",
      "kind": "pfValue",
      "bloom": "理解",
      "lc": "N-7-2",
      "seg": "七上2-1-S2",
      "params": {
        "p": [
          2,
          3,
          5
        ],
        "a": [
          1,
          2,
          3,
          4
        ],
        "q": [
          3,
          5,
          7
        ],
        "b": [
          1,
          2,
          3
        ]
      },
      "when": "p < q && a + b >= 3 && pow(p,a)*pow(q,b) <= 1500",
      "stem": "{pw(p,a)}×{pw(q,b)} 的值是多少？",
      "answer": "pow(p,a)*pow(q,b)",
      "check": {
        "type": "value",
        "expr": "{pw(p,a)}×{pw(q,b)}"
      },
      "okfb": "正確！{pw(p,a)}×{pw(q,b)}＝{pow(p,a)}×{pow(q,b)}＝{pow(p,a)*pow(q,b)}。",
      "hint": "先把每個次方算出來，再相乘。",
      "distractors": [
        "PF06",
        "PF07",
        "PF14",
        "G01"
      ],
      "pick": 3
    },
    {
      "tpl": "PF-count",
