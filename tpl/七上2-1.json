      "let": {
        "N": "pow(p,a)*pow(q,b)*r"
      },
      "when": "p < q && q < r",
      "stem": "已知 M＝{fac(N)}，下列哪一個是 M 的因數？（不用把 M 算出來）",
      "answer": "pw(p,a-1) + '×' + pw(q,b) + '×' + r",
      "check": {
        "type": "isFactor",
        "of": "{fac(N)}",
        "want": true
      },
      "okfb": "正確！每個質因數的次方都不超過 M：{pw(p,a-1)}≤{pw(p,a)}、{pw(q,b)}、{r} 都在 M 裡。",
      "hint": "比較同一個質因數的次方，每個次方都不能超過 M。",
      "distractors": [
        "PF09a",
        "PF09b",
        "PF11"
      ],
      "pick": 3
