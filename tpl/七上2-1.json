          11
        ],
        "f": [
          0,
          1
        ]
      },
      "let": {
        "N": "pow(p,a)*pow(q,b)*r"
      },
      "when": "p < q && (r == 1 || q < r) && N <= 2000 && p*a*q*b*r < N/p",
      "stem": "已知 M＝{fac(N)}，下列哪一個「不是」M 的因數？",
      "answer": "f == 0 ? pow(p,a+1) : pow(q,b+1)",
      "check": {
        "type": "isFactor",
        "of": "{fac(N)}",
        "want": false
      },
      "okfb": "正確！{f == 0 ? pow(p,a+1) : pow(q,b+1)}＝{f == 0 ? pw(p,a+1) : pw(q,b+1)}，次方比 M 裡的 {f == 0 ? pw(p,a) : pw(q,b)} 大，所以不是 M 的因數；其他三個都能整除 M。",
      "hint": "把每個選項寫成質因數的次方，和 M 比：每個質因數的次方都不超過 M 的，就是 M 的因數。",
      "distractors": [
        "PF10a",
        "PF10b",
        "PF13",
        "PF06"
