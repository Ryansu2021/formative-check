{
  "schema": "fa-tpl/1",
  "unit": {"grade": "七上", "code": "2-1", "name": "質因數分解、標準分解式", "curriculum": ["N-7-1 質數與合數", "N-7-2 質因數分解的標準分解式"]},
  "note": "每個模板產一組平行題（A、B 卷同一組規則、不同數字）；distractors 是 rules.js 的規則 id，pick 是每題用幾條",
  "tpls": [
    {"tpl": "PF-factorize", "title": "標準分解式辨認", "kind": "factorize", "bloom": "理解", "lc": "N-7-2", "params": {"p": [2, 3], "a": [1, 2, 3, 4], "q": [3, 5, 7], "b": [1, 2, 3], "r": [1, 7, 11, 13]}, "let": {"n": "pow(p,a)*pow(q,b)*r"}, "when": "p < q && (r == 1 || q < r) && a + b >= 3 && n >= 40 && n <= 800", "stem": "{n} 的標準分解式是哪一個？", "answer": "fac(n)", "check": {"type": "factorize", "n": "{n}"}, "okfb": "正確！{n}＝{fac(n)}。", "hint": "分解完要檢查：都是質數嗎？相同的有合併嗎？乘回去是 {n} 嗎？", "distractors": ["PF07", "PF04", "PF03", "PF05", "PF01"], "pick": 3},
    {"tpl": "PF-value", "title": "標準分解式求值", "kind": "pfValue", "bloom": "理解", "lc": "N-7-2", "params": {"p": [2, 3, 5], "a": [1, 2, 3, 4], "q": [3, 5, 7], "b": [1, 2, 3]}, "when": "p < q && a + b >= 3 && pow(p,a)*pow(q,b) <= 1500", "stem": "{pw(p,a)}×{pw(q,b)} 的值是多少？", "answer": "pow(p,a)*pow(q,b)", "check": {"type": "value", "expr": "{pw(p,a)}×{pw(q,b)}"}, "okfb": "正確！{pw(p,a)}×{pw(q,b)}＝{pow(p,a)}×{pow(q,b)}＝{pow(p,a)*pow(q,b)}。", "hint": "先把每個次方算出來，再相乘。", "distractors": ["PF06", "PF07", "PF14", "G01"], "pick": 3},
    {"tpl": "PF-count", "title": "相異質因數個數", "kind": "pfCount", "bloom": "理解", "lc": "N-7-2", "params": {"p": [2, 3], "a": [1, 2, 3], "q": [3, 5, 7], "b": [1, 2], "r": [1, 5, 7, 11]}, "let": {"n": "pow(p,a)*pow(q,b)*r"}, "when": "p < q && (r == 1 || q < r) && a + b >= 3 && n >= 60 && n <= 2000", "stem": "{n} 有幾個相異的質因數？", "answer": "distinctPrimes(n)", "check": {"type": "value", "fn": "distinctPrimes", "n": "{n}"}, "okfb": "正確！{n}＝{fac(n)}，相異質因數是 {primes(n)}。", "hint": "先寫出標準分解式，再數有幾個不同的底數。", "distractors": ["PF08", "PF01", "PF03"], "pick": 3},
    {"tpl": "PF-primeSet", "title": "質因數有哪些", "kind": "pfSet", "bloom": "理解", "lc": "N-7-2", "params": {"p": [2, 3], "a": [1, 2, 3], "q": [3, 5, 7], "b": [1, 2], "r": [1, 5, 7]}, "let": {"n": "pow(p,a)*pow(q,b)*r"}, "when": "p < q && (r == 1 || q < r) && a + b >= 3 && n >= 40 && n <= 400", "stem": "{n} 的質因數有哪些？", "answer": "primes(n)", "check": {"type": "primeSet", "n": "{n}"}, "okfb": "正確！{n}＝{fac(n)}，質因數是 {primes(n)}。", "hint": "質因數＝是 {n} 的因數、又是質數。", "distractors": ["PF01", "PF08", "PF02"], "pick": 3},
    {"tpl": "PF-isFactor", "title": "用標準分解式判因數", "kind": "pfIsFactor", "bloom": "應用", "lc": "N-7-2", "params": {"p": [2, 3], "a": [2, 3, 4], "q": [3, 5], "b": [1, 2, 3], "r": [5, 7, 11]}, "let": {"N": "pow(p,a)*pow(q,b)*r"}, "when": "p < q && q < r", "stem": "已知 M＝{fac(N)}，下列哪一個是 M 的因數？（不用把 M 算出來）", "answer": "pw(p,a-1) + '×' + pw(q,b) + '×' + r", "check": {"type": "isFactor", "of": "{fac(N)}", "want": true}, "okfb": "正確！每個質因數的次方都不超過 M：{pw(p,a-1)}≤{pw(p,a)}、{pw(q,b)}、{r} 都在 M 裡。", "hint": "比較同一個質因數的次方，每個次方都不能超過 M。", "distractors": ["PF09a", "PF09b", "PF11"], "pick": 3},
    {"tpl": "PF-isPrime", "title": "質數辨認", "kind": "pfIsPrime", "bloom": "理解", "lc": "N-7-1", "params": {"x": [53, 59, 61, 67, 71, 73, 79, 83, 89, 97, 101, 103, 107, 109, 113], "c1": [51, 57, 87, 93], "c2": [91, 119, 133, 143], "c3": [111, 117, 129, 141, 161]}, "stem": "下列哪一個是質數？", "answer": "x", "check": {"type": "isPrime", "want": true}, "okfb": "正確！{x} 試除到 √{x} 都不能整除，是質數。", "hint": "試除 2、3、5、7、11：用到的質數平方超過這個數就可以停。", "distractors": ["PF12a", "PF12b", "PF12c", "PF01"], "pick": 3, "distinctAB": ["x", "c1", "c2", "c3"]}
  ]
}
