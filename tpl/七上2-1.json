    {
      "tpl": "PF-isFactor",
      "title": "用標準分解式判因數",
      "kind": "pfIsFactor",
      "bloom": "應用",
      "lc": "N-7-2",
      "seg": "七上2-1-S2",
      "params": {
        "p": [
          2,
          3
