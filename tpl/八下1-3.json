 "tpls": [
  {
   "tpl": "GP-r",
   "title": "求公比",
   "kind": "gpR",
   "bloom": "理解",
   "lc": "N-8-6",
   "seg": "八下1-3-S1",
   "params": {
    "rr": [
     0,
     1,
     2,
     3,
     4,
     5
    ],
    "s": [
     1,
     2,
     3,
     4,
     5,
     -1,
     -2,
     -3
    ],
    "fr": [
     0,
     1
    ]
   },
   "let": {
    "rn": "rr == 0 ? -2 : rr == 1 ? -3 : rr == 2 ? -4 : rr == 3 ? -1 : rr == 4 ? -1 : -2",
    "rd": "rr == 3 ? 2 : rr == 4 ? 3 : rr == 5 ? 3 : 1",
    "x1": "s * pow(rd, 3)",
    "x2": "s * pow(rd, 2) * rn"
   },
   "when": "(abs(s * pow(rd, 3)) <= 120 && abs(s * pow(rn, 3)) <= 200) && fr == (rd > 1 ? 1 : 0)",
   "sameAB": [
    "fr"
   ],
   "stem": "等比數列 {gpList(x1, rn, rd, 4)}, … 的公比是多少？",
   "answer": "frT(rn, rd)",
   "check": {
    "type": "value",
    "expr": "{negP(x2)}÷{negP(x1)}"
   },
   "okfb": "正確！公比＝後項÷前項＝{negP(x2)}÷{negP(x1)}＝{frT(rn, rd)}，檢查：{negP(x1)}×{gpRP(rn, rd)}＝{sgn(x2)}。",
   "hint": "公比＝後項÷前項，算完用「前項×公比」檢查。",
   "distractors": [
    "GP01",
    "GP07",
    "GP05"
   ],
   "pick": 3
