   "params": {"v": ["−0.5", "−0.2", "−0.8", "−0.3", "−0.6", "−0.9", "−1/2", "−1/3", "−2/3", "−3/4"], "m": [1.2, 1.5, 1.8, 2.5, 3.5, 1.25, 1.75, 2.4]},
   "stem": "下列哪一個是「比 −1 大的負數」？", "answer": "v", "check": {"type": "range", "gt": -1, "lt": 0},
   "okfb": "正確！{v} 在 −1 的右邊、原點的左邊，是比 −1 大的負數。",
