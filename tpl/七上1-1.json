  {"tpl": "NL-opp", "title": "互為相反數", "kind": "nlOpp", "bloom": "理解", "lc": "N-7-5", "seg": "七上1-1-S2",
   "params": {"k": [2, 3, 4, 5, 6, 7, 8, 9, 10, 12], "c": [1, 2, 3, -1, -2], "e": [2, 3, 4, 5, 6], "j": [2, 3, 4, 5, 6, 7, 8, 9], "h": [2, 3, 4, 5, 6, 7, 8, 9]},
   "when": "(c - e) * (c + e) < 0 && j != k && h != k && h != j",
