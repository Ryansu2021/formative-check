   "distractors": ["NL08", "NL11a", "NL11b"], "pick": 3},
  {"tpl": "NL-btw", "title": "介於兩個負整數之間的數", "kind": "nlBtw", "bloom": "理解", "lc": "N-7-5", "seg": "七上1-1-S1",
