{
  "schema": "fa-tpl/1",
  "unit": {
    "grade": "七上",
    "code": "1-4",
    "name": "指數記法、10 的負次方、科學記號",
    "curriculum": [
      "N-7-6 指數的意義",
      "N-7-8 科學記號"
    ]
  },
  "note": "每個模板產一組平行題（A、B 卷同一組規則、不同數字）；distractors 是 rules.js 的規則 id，pick 是每題用幾條",
  "tpls": [
    {
      "tpl": "EX-negOut",
      "title": "減號後面接次方",
      "kind": "exSubPow",
      "bloom": "理解",
      "lc": "N-7-6",
      "seg": "七上1-4-S1",
      "params": {
        "c": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          9
        ],
        "a": [
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "n": [
          2,
          4
        ]
      },
      "when": "c != a && pow(a,n) <= 700 && pow(a,n) > c",
      "stem": "{c}−{a}^{n}＝？",
      "answer": "c - pow(a,n)",
      "check": {
        "type": "value",
        "expr": "{c}−{a}^{n}"
      },
      "okfb": "正確！先算次方 {a}^{n}＝{pow(a,n)}，再減：{c}−{pow(a,n)}＝{sgn(c - pow(a,n))}。",
      "hint": "先乘方、再加減；{a}^{n} 前面的減號不在次方裡面。",
      "distractors": [
        "EX01",
        "EX05",
        "EX02"
      ],
      "pick": 3
    },
    {
      "tpl": "EX-negIn",
      "title": "負數的奇數次方",
      "kind": "exPow",
      "bloom": "理解",
      "lc": "N-7-6",
      "seg": "七上1-4-S1",
      "params": {
        "a": [
          2,
          3,
          4,
          5
        ],
        "n": [
          3,
          5
        ],
        "form": "in"
      },
      "when": "pow(a,n) <= 1000",
      "stem": "(−{a})^{n}＝？",
      "answer": "pow(-a,n)",
      "check": {
        "type": "value",
        "expr": "(−{a})^{n}"
      },
      "okfb": "正確！{n} 個 −{a} 相乘，奇數個負數相乘是負的：−{pow(a,n)}。",
      "hint": "負數的奇數次方是負的，偶數次方是正的。",
      "distractors": [
        "EX04",
        "EX02",
        "EX02s"
      ],
      "pick": 3
    },
    {
      "tpl": "EX-01",
      "title": "0 和 1 的次方",
      "kind": "ex01",
      "bloom": "理解",
      "lc": "N-7-6",
      "seg": "七上1-4-S1",
      "params": {
        "m": [
          3,
          4,
          5,
          6,
          7,
          8,
          9
        ],
        "k": [
          2,
          3,
          4,
          5,
          6
        ]
      },
      "when": "m != k && m != 2",
      "stem": "1^{m}＋0^{k}＝？",
      "answer": "1",
      "check": {
        "type": "value",
        "expr": "1^{m}+0^{k}"
      },
      "okfb": "正確！1^{m}＝1、0^{k}＝0，1＋0＝1。",
      "hint": "1 的任何次方都是 1；0 的正整數次方都是 0。",
      "distractors": [
        "EX03a",
        "EX03b",
        "EX02"
      ],
      "pick": 3
    },
    {
      "tpl": "EX-neg10",
      "title": "10 的負次方",
      "kind": "exNeg10",
      "bloom": "理解",
      "lc": "N-7-6",
      "seg": "七上1-4-S2",
      "params": {
        "n": [
          2,
          3,
          4,
          5,
          6
        ]
      },
      "stem": "10^-{n}＝？",
      "answer": "dec(n)",
      "check": {
        "type": "value",
        "expr": "10^-{n}"
      },
      "okfb": "正確！10^-{n}＝1/10^{n}＝{dec(n)}，1 在小數點後第 {n} 位。",
      "hint": "10 的負 n 次方＝1/10ⁿ，1 在小數點後第 n 位。",
      "distractors": [
        "EX06",
        "EX07a",
        "EX07b",
        "EX02"
      ],
      "pick": 3
    },
    {
      "tpl": "EX-sci",
      "title": "寫成科學記號",
      "kind": "exSci",
      "bloom": "理解",
      "lc": "N-7-8",
      "seg": "七上1-4-S2",
      "params": {
        "M": [
          12,
          15,
          23,
          36,
          48,
          235,
          306,
          725,
          108,
          4125
        ],
        "k": [
          4,
          5,
          6,
          7,
          8
        ]
      },
      "let": {
        "d": "len(M) - 1",
        "N": "sciN(M, len(M) - 1, k)"
      },
      "when": "k > d",
      "stem": "{N} 用科學記號表示是哪一個？",
      "answer": "shift(M, d) + '×10^' + k",
      "check": {
        "type": "sci",
        "value": "{N}"
      },
      "okfb": "正確！{N}＝{shift(M,d)}×10^{k}，1≤{shift(M,d)}＜10。",
      "hint": "a×10ⁿ：a 要在 1 到 10 之間（可以是 1，不能是 10）。",
      "distractors": [
        "EX08a",
        "EX10",
        "EX08b"
      ],
      "pick": 3
    },
    {
      "tpl": "EX-cmp",
      "title": "科學記號比大小",
      "kind": "exCmp",
      "bloom": "分析",
      "lc": "N-7-8",
      "seg": "七上1-4-S3",
      "params": {
        "a1": [
          1.2,
          1.5,
          2.1,
          3.4
        ],
        "m": [
          4,
          5,
          6,
          7
        ],
        "c1": [
          9.8,
          8.7,
          7.6
        ],
        "c2": [
          9.9,
          9.5,
          6.4
        ],
        "c3": [
          7.5,
          8.2,
          9.1
        ],
        "e": [
          3,
          4,
          5,
          6,
          7,
          8
        ]
      },
      "stem": "下列哪一個數最大？",
      "answer": "a1 + '×10^' + m",
      "check": {
        "type": "extreme",
        "want": "max"
      },
      "okfb": "正確！先比指數：10^{m} 最大，所以 {a1}×10^{m} 最大。",
      "hint": "科學記號比大小：先比指數，指數一樣再比係數。",
      "distractors": [
        "EX09a",
        "EX09b",
        "EX11"
      ],
      "pick": 3,
      "distinctAB": [
        "m"
      ]
    },
    {
      "tpl": "EX-zero",
      "title": "10 的 0 次方與負次方",
      "kind": "exZero",
      "bloom": "理解",
      "lc": "N-7-6",
      "seg": "七上1-4-S2",
      "params": {
        "f": [
          0,
          1
        ],
        "p": [
          1,
          2,
          3
        ],
        "q": [
          1,
          2,
          3,
          4
        ]
      },
      "when": "f == 1 || q <= 3",
      "stem": "{f == 0 ? '10^' + p + '＋10^0＋10^-' + q : '10^0−10^-' + q}＝？",
      "answer": "exZans(f, p, q)",
      "check": {
        "type": "value",
        "expr": "{f == 0 ? '10^' + p + '+10^0+10^-' + q : '10^0−10^-' + q}"
      },
      "okfb": "正確！10⁰＝1，{sup('10^-' + q)}＝{dec(q)}，答案是 {exZans(f, p, q)}。",
      "hint": "10^0＝1；10^-n＝1/10ⁿ，1 在小數點後第 n 位。",
      "distractors": [
        "EX12a",
        "EX12b",
        "EX06",
        "EX07a",
        "EX07b"
      ],
      "pick": 3,
      "sameAB": [
        "f"
      ]
    },
    {
      "tpl": "EX-swap",
      "title": "含次方的四則運算（底數與指數）",
      "kind": "exSwap",
      "bloom": "應用",
      "lc": "N-7-6",
      "seg": "七上1-4-S1",
      "params": {
        "c": [
          10,
          12,
          15,
          18,
          20,
          25,
          30
        ],
        "k": [
          2,
          3
        ],
        "a": [
          2,
          3,
          4,
          5
        ],
        "n": [
          2,
          3
        ]
      },
      "when": "a != n && pow(a, n) != pow(n, a) && pow(k * a, n) <= 1000",
      "stem": "{c}−{k}×{a}^{n}＝？",
      "answer": "c - k * pow(a, n)",
      "check": {
        "type": "value",
        "expr": "{c}−{k}×{a}^{n}"
      },
      "okfb": "正確！先算 {a}^{n}＝{pow(a, n)}（{n} 個 {a} 相乘），再算 {k}×{pow(a, n)}＝{k * pow(a, n)}，最後 {c}−{k * pow(a, n)}＝{sgn(c - k * pow(a, n))}。",
      "hint": "先乘方、再乘除、最後加減；aⁿ 是 n 個 a 相乘。",
      "distractors": [
        "EX13",
        "EX05",
        "EX02"
      ],
      "pick": 3
    },
    {
      "tpl": "EX-toNum",
      "title": "科學記號寫成一般的數",
      "kind": "exToNum",
      "bloom": "理解",
      "lc": "N-7-8",
      "seg": "七上1-4-S2",
      "params": {
        "M": [
          12,
          15,
          23,
          32,
          36,
          45,
          48,
          52,
          64,
          71,
          87,
          125,
          235,
          275,
          306,
          408
        ],
        "n": [
          4,
          5,
          6,
          7,
          8
        ]
      },
      "when": "n > len(M) - 1",
      "stem": "{shift(M, len(M) - 1)}×10^{n} 寫成一般的數，是多少？",
      "answer": "sciN(M, len(M) - 1, n)",
      "check": {
        "type": "value",
        "expr": "{shift(M, len(M) - 1)}×10^{n}"
      },
      "okfb": "正確！{shift(M, len(M) - 1)} 的小數點往右移 {n} 位，得 {sciN(M, len(M) - 1, n)}。",
      "hint": "a×10ⁿ（n 是正的）：a 的小數點往右移 n 位，移不到的位才補 0。",
      "distractors": [
        "EX14",
        "EX10",
        "EX15"
      ],
      "pick": 3
    },
    {
      "tpl": "EX-sciS",
      "title": "比 1 小的數寫成科學記號",
      "kind": "exSciS",
      "bloom": "理解",
      "lc": "N-7-8",
      "seg": "七上1-4-S2",
      "params": {
        "M": [
          12,
          25,
          34,
          48,
          56,
          63,
          72,
          83,
          91,
          125,
          235,
          406
        ],
        "k": [
          3,
          4,
          5,
          6,
          7
        ]
      },
      "stem": "把 {sciSmall(M, k)} 寫成科學記號，正確的是？",
      "answer": "shift(M, len(M) - 1) + '×10^-' + k",
      "check": {
        "type": "sci",
        "value": "{sciSmall(M, k)}"
      },
      "okfb": "正確！小數點往右移 {k} 位得 {shift(M, len(M) - 1)}，這個數比 1 小，指數是 −{k}。",
      "hint": "先判斷這個數比 1 大還是比 1 小；比 1 小的指數是負的。",
      "distractors": [
        "EX15",
        "EX07",
        "EX08"
      ],
      "pick": 3
    },
    {
      "tpl": "EX-rel",
      "title": "科學記號比大小（哪一個正確）",
      "kind": "exRel",
      "bloom": "分析",
      "lc": "N-7-8",
      "seg": "七上1-4-S3",
      "params": {
        "s": [
          0,
          1
        ],
        "w": [
          0,
          1
        ],
        "u": [
          1.2,
          2.3,
          4.3,
          5.4
        ],
        "v": [
          6.1,
          8.6,
          9.5
        ],
        "h": [
          3,
          4,
          5,
          6
        ],
        "B": [
          27,
          38,
          46,
          53,
          63,
          72,
          84,
          91
        ],
        "g": [
          0.18,
          0.25,
          0.36,
          0.45
        ],
        "c": [
          1.5,
          2.4,
          5.1,
          6.8
        ],
        "e": [
          3,
          4,
          5,
          6,
          7
        ],
        "x": [
          4.1,
          6.5,
          8.2,
          9.3
        ],
        "y": [
          1.5,
          2.6,
          3.9
        ],
        "f": [
          2,
          3,
          4,
          5
        ],
        "z": [
          2.5,
          3.5,
          6.2,
          7.4
        ],
        "t": [
          5,
          6,
          7,
          8,
          9
        ]
      },
      "let": {
        "hu": "s == 1 ? '-' + h : '' + h",
        "hv": "s == 1 ? '-' + (h + 1) : '' + (h - 1)"
      },
      "stem": "下列哪一個大小關係正確？",
      "answer": "w == 0 ? u + '×10^' + hu + '＞' + v + '×10^' + hv : v + '×10^' + hv + '＜' + u + '×10^' + hu",
      "check": {
        "type": "trueStmt",
        "want": true
      },
      "okfb": "正確！先比指數：{sgn(s == 1 ? -h : h)} 比 {sgn(s == 1 ? -h - 1 : h - 1)} 大，所以 {u}×{sup('10^' + hu)} 比較大（不用看 {u} 比 {v} 小）。",
      "hint": "先確認 a 在 1 到 10 之間（不是就先化成科學記號），再先比指數、後比 a。",
      "distractors": [
        "EX16",
        "EX16b",
        "EX09",
        "EX11"
      ],
      "pick": 3
    }
  ]
}
