          1,
          2,
          3,
          4,
          5,
          6
        ]
      },
      "when": "gcd(A, abs(p)) == 1 && A*q + p != 0 && p != q && abs(p*q) <= 30",
      "stem": "因式分解 {polyS(A, A*q+p, p*q)}，結果是哪一個？",
      "answer": "fac2(A, p, 1, q)",
      "check": {
        "type": "factorForm",
        "expr": "{polyR(A, A*q+p, p*q)}"
      },
      "okfb": "正確！十字圖第一列 {A}x、{sgn(p)}，第二列 x、{sgn(q)}，交叉相乘 {A}x×{negP(q)}＋x×{negP(p)}＝{sgn(A*q+p)}x，橫著讀：{fac2(A, p, 1, q)}。",
      "hint": "十字圖左邊拆二次項 {A}x²＝{A}x×x，右邊拆常數項；交叉相乘的和要等於一次項，寫因式時橫著讀。",
      "distractors": [
        "CX11",
        "CX04",
        "CX03",
        "CX10"
      ],
      "pick": 3
    },
    {
      "tpl": "CX-read",
      "title": "十字圖讀成因式",
      "kind": "cxA",
      "bloom": "理解",
      "lc": "A-8-5",
      "seg": "八上3-2-S2",
      "params": {
        "A": [
          2,
          3,
          5
        ],
        "p": [
          -7,
