        "q": [
          -6,
          -5,
          -4,
          -3,
          -2,
          -1,
          1,
          2,
          3,
          4,
          5,
          6
        ]
      },
      "when": "gcd(A, abs(p)) == 1 && A*q + p != 0 && p != q && abs(p*q) <= 30",
      "stem": "用十字交乘法分解 {polyS(A, A*q+p, p*q)}：十字圖第一列是 {A}x、{sgn(p)}，第二列是 x、{sgn(q)}（交叉相乘 {A}x×{negP(q)}＋x×{negP(p)}＝{sgn(A*q+p)}x）。分解的結果是哪一個？",
      "answer": "fac2(A, p, 1, q)",
      "check": {
        "type": "factorForm",
        "expr": "{polyR(A, A*q+p, p*q)}"
      },
      "okfb": "正確！十字圖要橫著讀：第一列是 ({lin(A, p)})，第二列是 ({lin(1, q)})，所以是 {fac2(A, p, 1, q)}。",
      "hint": "十字圖斜線是用來檢查交叉相乘的和；寫因式時一列一個因式（橫著讀）。",
      "distractors": [
        "CX04",
        "CX11",
        "CX03"
      ],
      "pick": 3
