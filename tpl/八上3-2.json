    {
      "tpl": "CX-k",
      "title": "已知分解結果求係數",
      "kind": "cxK",
      "bloom": "理解",
      "lc": "A-8-4",
      "seg": "八上3-2-S1",
      "params": {
        "m": [
          -9,
