{
  "schema": "fa-tpl/1",
  "unit": {
    "grade": "七上",
    "code": "1-2",
    "name": "整數的加減、去括號、兩點距離",
    "curriculum": [
      "N-7-3 負數與數的四則混合運算（加減）",
      "N-7-5 數線上兩點的距離"
    ]
  },
  "note": "每個模板產一組平行題（A、B 卷同一組規則、不同數字）；distractors 是 rules.js 的規則 id，pick 是每題用幾條",
  "tpls": [
    {
      "tpl": "AS-add",
      "title": "異號相加",
      "kind": "asAdd",
      "bloom": "理解",
      "lc": "N-7-3",
      "seg": "七上1-2-S1",
      "params": {
        "a": [
          2,
          3,
          4,
          5,
          6,
          7,
          9,
          12
        ],
        "b": [
          3,
          5,
          7,
          8,
          9,
          11,
          13,
          15
        ]
      },
      "when": "b > a + 1 && a + b <= 24",
      "stem": "{a}＋(−{b})＝？",
      "answer": "a - b",
      "check": {
        "type": "value",
        "expr": "{a}+(−{b})"
      },
      "okfb": "正確！異號相加：{b}−{a}＝{b-a}，正負號跟絕對值大的 −{b}，得 {sgn(a-b)}。",
      "hint": "異號相加：大的絕對值減小的，正負號跟絕對值大的數。",
      "distractors": [
        "AS02",
        "AS10",
        "AS01"
      ],
      "pick": 3
    },
    {
      "tpl": "AS-sub",
      "title": "減去負數",
      "kind": "asSub",
      "bloom": "理解",
      "lc": "N-7-3",
      "seg": "七上1-2-S2",
      "params": {
        "a": [
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "s": [
          -1
        ],
        "b": [
          4,
          6,
          8,
          9,
          11,
          12
        ]
      },
      "when": "a < b && b - a != a + b",
      "stem": "{a}−(−{b})＝？",
      "answer": "a + b",
      "check": {
        "type": "value",
        "expr": "{a}−(−{b})"
      },
      "okfb": "正確！減去 −{b} 就是加上 {b}：{a}＋{b}＝{a+b}。",
      "hint": "減去一個數，等於加上它的相反數。",
      "distractors": [
        "AS08",
        "AS04",
        "AS03"
      ],
      "pick": 3
    },
    {
      "tpl": "AS-paren",
      "title": "去括號",
      "kind": "asParen",
      "bloom": "應用",
      "lc": "N-7-3",
      "seg": "七上1-2-S2",
      "params": {
        "a": [
          8,
          10,
          12,
          15,
          20
        ],
        "b": [
          2,
          3,
          4,
          6
        ],
        "c": [
          5,
          7,
          8,
          9
        ]
      },
      "when": "b < c && a - b - c != 0",
      "stem": "{a}−({b}−{c})＝？",
      "answer": "a - b + c",
      "check": {
        "type": "value",
        "expr": "{a}−({b}−{c})"
      },
      "okfb": "正確！括號裡 {b}−{c}＝−{c-b}，{a}−(−{c-b})＝{a-b+c}；或去括號 {a}−{b}＋{c}＝{a-b+c}。",
      "hint": "括號前是減號，去括號時括號裡每一項都要變號。",
      "distractors": [
        "AS05",
        "AS03",
        "AS04"
      ],
      "pick": 3
    },
    {
      "tpl": "AS-abs",
      "title": "減去絕對值",
      "kind": "asAbs",
      "bloom": "理解",
      "lc": "N-7-3",
      "seg": "七上1-2-S2",
      "params": {
        "a": [
          2,
          3,
          4,
          5,
          6
        ],
        "b": [
          7,
          8,
          9,
          11,
          12
        ]
      },
      "when": "a < b",
      "stem": "{a}−|−{b}|＝？",
      "answer": "a - b",
      "check": {
        "type": "value",
        "expr": "{a}−|−{b}|"
      },
      "okfb": "正確！|−{b}|＝{b}，{a}−{b}＝{sgn(a-b)}。",
      "hint": "先算絕對值，再做減法。",
      "distractors": [
        "AS06",
        "AS03",
        "AS10"
      ],
      "pick": 3
    },
    {
      "tpl": "AS-dist",
      "title": "數線上兩點距離",
      "kind": "asDist",
      "bloom": "應用",
      "lc": "N-7-5",
      "seg": "七上1-2-S3",
      "params": {
        "a": [
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "b": [
          3,
          4,
          5,
          6,
          8,
          9
        ]
      },
      "when": "a != b",
      "stem": "數線上 A(−{a})、B({b})，A、B 兩點的距離是多少？",
      "answer": "a + b",
      "check": {
        "type": "value",
        "expr": "{b}−(−{a})"
      },
      "okfb": "正確！距離＝右邊減左邊：{b}−(−{a})＝{a+b}。",
      "hint": "距離＝右邊的坐標減左邊的坐標，一定是正的。",
      "distractors": [
        "AS09",
        "AS07",
        "G03"
      ],
      "pick": 3
    },
    {
      "tpl": "AS-range",
      "title": "哪一個比原數大",
      "kind": "asRange",
      "bloom": "分析",
      "lc": "N-7-3",
      "seg": null,
      "params": {
        "x": [
          -2,
          -3,
          -4,
          -5
        ],
        "b": [
          3,
          4,
          5,
          6
        ],
        "e": [
          2,
          3,
          5,
          7
        ],
        "c": [
          2,
          3,
          4,
          6
        ],
        "g": [
          1,
          2,
          3,
          4
        ],
        "h": [
          8,
          9,
          10,
          11,
          12
        ]
      },
      "when": "e != c && g - h < x",
      "stem": "下列哪一個算式的結果比 {sgn(x)} 大？",
      "answer": "sgn(x) + '−(−' + b + ')'",
      "check": {
        "type": "range",
        "gt": "{x}"
      },
      "okfb": "正確！{sgn(x)}−(−{b})＝{sgn(x)}＋{b}＝{sgn(x+b)}，比 {sgn(x)} 大。",
      "hint": "每個算式都先算出來，再和 {sgn(x)} 比。",
      "distractors": [
        "AS01",
        "AS06",
        "AS02"
      ],
      "pick": 3
    }
  ]
}
