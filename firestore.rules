rules_version = '2';

// ============================================================
//  Firebase 專案 prime-challenge 的完整安全規則
//  包含：① 數字大挑戰（sessions，原本的規則不變）
//        ② 課堂形成性檢核（fa_sessions，新增）
//  使用方式：複製全部內容，貼到 Firebase 主控台 → Firestore Database → 規則 → 發布
//  ⚠ 規則是整份取代：一定要貼這份「合併版」，不要只貼新增的部分，否則數字大挑戰會失效
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ghsghs1@gmail.com'];
    }

    // ---------------- ① 數字大挑戰（原本的規則） ----------------
    function sessionActive(code) {
      return get(/databases/$(database)/documents/sessions/$(code)).data.active == true;
    }

    match /sessions/{code} {
      allow get: if request.auth != null;
      allow list, create, update, delete: if isTeacher();

      match /students/{seat} {
        allow get: if isTeacher()
          || (request.auth != null && (resource == null || resource.data.uid == request.auth.uid));
        allow list, delete: if isTeacher();
        allow create: if request.auth != null
          && seat.matches('^[1-9][0-9]?$')
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.seat == int(seat)
          && sessionActive(code);
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.seat == resource.data.seat
          && sessionActive(code);
      }
    }

    // ---------------- ② 課堂形成性檢核（新增） ----------------
    function faSession(code) {
      return get(/databases/$(database)/documents/fa_sessions/$(code)).data;
    }
    function faOwnsSeat(code, seat) {
      return get(/databases/$(database)/documents/fa_sessions/$(code)/students/$(string(seat))).data.uid == request.auth.uid;
    }

    // 場次：學生可讀單一場次（題幹、選項、目前題號；正解只在公布後寫入）
    match /fa_sessions/{code} {
      allow get: if request.auth != null;
      allow list, create, update, delete: if isTeacher();

      // 座號：每個座號一份，學生只能占用空座號
      match /students/{seat} {
        allow get: if isTeacher()
          || (request.auth != null && (resource == null || resource.data.uid == request.auth.uid));
        allow list, delete: if isTeacher();
        allow create: if request.auth != null
          && seat.matches('^[1-9][0-9]?$')
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.seat == int(seat)
          && faSession(code).active == true;
      }

      // 作答：文件 ID＝座號_題號_r輪次；只有「作答中」、且是目前這一題與這一輪才能寫入
      match /responses/{rid} {
        allow get: if isTeacher()
          || (request.auth != null && (resource == null || resource.data.uid == request.auth.uid));
        allow list, delete: if isTeacher();
        allow create, update: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && rid == string(request.resource.data.seat) + '_' + request.resource.data.itemId + '_r' + string(request.resource.data.round)
          && faOwnsSeat(code, request.resource.data.seat)
          && faSession(code).active == true
          && faSession(code).phase == 'open'
          && faSession(code).curItemId == request.resource.data.itemId
          && faSession(code).round == request.resource.data.round
          && request.resource.data.choice is string
          && request.resource.data.conf in ['high', 'mid', 'low'];
      }
    }
  }
}
