  "misconceptions": [
    {
      "code": "MD01",
      "name": "以為除法有結合律",
      "desc": "連除時先算後面兩個數，以為 a÷b÷c＝a÷(b÷c)；或以為除法可以交換",
      "example": "(−36)÷12÷3＝(−36)÷4",
      "remedy": "讓學生比較 (−36)÷12÷3、(−36)÷(12×3)、(−36)÷(12÷3) 三式，用具體數字找反例。",
      "source": "知識卡迷思「除法也有交換律、結合律（(－36)÷12÷3 先算 12÷3）」三版課本皆處理"
    },
    {
      "code": "MD02",
      "name": "分配律用在除法",
      "desc": "以為 a÷(b＋c)＝a÷b＋a÷c",
      "example": "60÷(10＋2)＝60÷10＋60÷2",
      "remedy": "用具體數字算兩邊比較；說明分配律只有 (b＋c)÷a＝b÷a＋c÷a 這個方向成立。",
      "source": "知識卡迷思「分配律也可用在除法（60÷(10＋2)＝60÷10＋60÷2）」三版課本皆處理"
    },
    {
      "code": "MD03",
      "name": "乘除同級先乘再除",
      "desc": "把 a÷b×c 當成 a÷(b×c)，沒有由左到右算",
      "example": "(−30)÷5×2＝(−30)÷10",
      "remedy": "比較 (−30)÷5×2 與 (−30)÷(5×2)；乘除同級由左到右，或把 ÷5 改寫成 ×1/5。",
      "source": "知識卡迷思「乘除同級時先乘再除（a÷b×c 當成 a÷(b×c)）」三版課本皆處理"
    },
    {
      "code": "MD04",
      "name": "連乘積正負號數錯",
      "desc": "連乘積的正負只看部分的負號個數，或沒有數清楚負號個數",
      "example": "(−2)×(−3)×(−1)×(−5) 是負數",
      "remedy": "先數負號個數：偶數個為正、奇數個為負，再算數字部分。",
      "source": "知識卡迷思「連乘積的正負只看部分的負號個數」三版課本皆處理"
    },
    {
      "code": "MD05",
      "name": "與 0、−1 相乘結果錯",
      "desc": "以為 0 乘以負數是負數，或不清楚與 0、1、−1 相乘的結果",
      "example": "0×(−6) 是負數",
      "remedy": "強調任何數乘以 0 都是 0，0 不是正數也不是負數；乘以 −1 得到相反數。",
      "source": "知識卡迷思「與 0、1、－1 相乘的結果」三版課本皆處理"
    },
    {
      "code": "MD06",
      "name": "符號規則錯（負負得負）",
      "desc": "同號相乘除得負、或異號相乘除得正，正負號規則弄反",
      "example": "(−3)×(−4)＝−12",
      "remedy": "用水位或符號變化表說明負負為什麼得正，不只背口訣；先定正負號再算數字。",
      "source": "知識卡迷思「負數乘負數為什麼是正（只記口訣）」三版課本皆處理（把規則弄反的情形依教學經驗）"
    },
    {
      "code": "MD07",
      "name": "0 與除法的意義不清",
      "desc": "以為 0÷a 不能算，或以為 a÷0 可以算（等於 0 或 a）",
      "example": "(−5)÷0＝0",
      "remedy": "用乘法驗算：a÷0＝□ 表示 □×0＝a，找不到這樣的數；0÷a＝0 因為 0×a＝0。",
      "source": "知識卡迷思「0 與除法：0÷a＝0、除數不可為 0」三版課本皆處理"
    },
    {
      "code": "MD08",
      "name": "減號負號並存沒變加",
      "desc": "減號後面接負數相乘時，把 −(−2)×4 當成 −2×4",
      "example": "−3−(−2)×4＝−3−8",
      "remedy": "先算乘法 (−2)×4＝−8，再處理「減去 −8＝加上 8」；把每一步寫出來。",
      "source": "知識卡迷思「減號與負號並存（減去負數要改成加）」康軒課本處理"
    },
    {
      "code": "MD09",
      "name": "運算順序錯",
      "desc": "忽略括號，或不管先乘除後加減，由左到右依序算",
      "example": "(−60)÷(10＋2) 算成 (−60)÷10＋2",
      "remedy": "先請學生說出國小的規則（括號優先、先乘除後加減），再用含負數的例題檢驗。",
      "source": "知識卡教學建議（四則運算先列出國小規則再用含負數例題檢驗）；迷思清單未列，依教學經驗"
    }
  ],
