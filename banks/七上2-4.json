  "misconceptions": [
    {
      "code": "EL01",
      "name": "同底數相乘指數相乘",
      "desc": "同底數相乘時把指數相乘（或連底數也相乘）",
      "example": "3^2×3^4＝3^8",
      "remedy": "寫成連乘：2 個 3 乘 4 個 3，共 (2＋4) 個 3；用對照題 3^2×3^4 與 (3^2)^4 各算一次。",
      "source": "知識卡迷思「同底數相乘時把指數相乘」：康軒 p.151 例5；南一 p.150 錯誤診療；翰林 p.139（備課眉批提醒學生常寫 3^(2×4)）"
    },
    {
      "code": "EL02",
      "name": "同底數相除指數相除",
      "desc": "同底數相除時把指數相除（或連底數也相除）",
      "example": "6^8÷6^2＝6^4",
      "remedy": "用約分看：8 個 6 約掉 2 個 6，剩 (8−2) 個。",
      "source": "知識卡迷思「同底數相除時把指數相除」：康軒 p.152 例6；南一 p.150 錯誤診療；翰林書末〈迷思逃脫〉2-4（5^6÷5^3 誤作 5^2）"
    },
    {
      "code": "EL03",
      "name": "次方的次方指數相加",
      "desc": "(a^m)^n 把指數相加（或做成 m^n）",
      "example": "(7^3)^2＝7^5",
      "remedy": "展開：(7^3)^2＝7^3×7^3，是 2 個 7^3，指數 3×2。",
      "source": "知識卡迷思「(aᵐ)ⁿ 誤把指數相加」：康軒 p.157 自我檢核4；南一、翰林未見"
    },
    {
      "code": "EL04",
      "name": "積的次方與相乘混用",
      "desc": "把不同底數的次方相乘時，指數相加或底數相加",
      "example": "2^5×3^5＝6^10",
      "remedy": "(a×b)^n＝a^n×b^n 只在指數相同時倒過來用；寫成 5 個 (2×3) 檢查。",
      "source": "知識卡迷思「混用乘法指數律與積的乘方」：康軒 p.157 自我檢核5；南一、翰林未見"
    },
    {
      "code": "EL05",
      "name": "以為次方愈高愈大",
      "desc": "忽略 0＜a＜1 時，次方愈高反而愈小",
      "example": "(2/3)^5＞(2/3)^2",
      "remedy": "用 (3/5)×(3/5)×(3/5) 問「每多乘一次，變大還是變小」，連到國小「乘數＜1 積變小」。",
      "source": "知識卡迷思「n 愈大 aⁿ 愈大（忽略 0<a<1）」：康軒 p.148、p.149 例2、p.157；南一 p.142 例2、p.149 自評1；翰林 2-4 未見（1-4 p.67 探索活動）"
    },
    {
